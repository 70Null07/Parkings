@rendermode InteractiveServer
@inject IJSRuntime JS
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="cw-widget">

    <!-- Кнопка-триггер -->
    <button class="cw-toggle" @onclick="ToggleOpen">
        <span class="cw-toggle-icon">💬</span>
        @if (unreadCount > 0)
        {
            <span class="cw-badge">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
        }
    </button>

    @if (isOpen)
    {
        <div class="cw-panel">
            @if (view == "dialogs")
            {
                <!-- ── Список диалогов ── -->
                <div class="cw-header">
                    <span class="cw-header-title">Сообщения</span>
                    <button class="cw-btn-icon" @onclick="ToggleOpen">✕</button>
                </div>
                <div class="cw-dialogs">
                    @if (loading)
                    {
                        <div class="cw-empty">⏳ Загрузка...</div>
                    }
                    else if (dialogs.Count == 0)
                    {
                        <div class="cw-empty">Нет диалогов</div>
                    }
                    else
                    {
                        @foreach (var d in dialogs)
                        {
                            var dlg = d;
                            <div class="cw-dialog-item @(d.Unread > 0 ? "cw-has-unread" : "")"
                                 @onclick="() => OpenDialog(dlg)">
                                <div class="cw-dialog-row1">
                                    <a class="cw-dialog-parking" href="/parking/@d.ParkingId">🅿 @d.ParkingName</a>
                                    <span class="cw-dialog-time">
                                        @d.LastAt.ToLocalTime().ToString("HH:mm")
                                    </span>
                                </div>
                                <div class="cw-dialog-row2">
                                    <span class="cw-dialog-who">@d.OtherName</span>
                                    @if (d.Unread > 0)
                                    {
                                        <span class="cw-unread-dot">@d.Unread</span>
                                    }
                                </div>
                                <div class="cw-dialog-last">@d.LastMessage</div>
                            </div>
                        }
                    }
                </div>
            }
            else if (view == "chat")
            {
                <!-- ── Открытый диалог ── -->
                <div class="cw-header">
                    <button class="cw-btn-icon" @onclick="BackToDialogs">←</button>
                    <div class="cw-header-meta">
                        <a class="cw-header-parking" href="/parking/@activeDialog!.ParkingId">@activeDialog!.ParkingName</a>
                        <span class="cw-header-who">@activeDialog.OtherName</span>
                    </div>
                    <button class="cw-btn-icon" @onclick="ToggleOpen">✕</button>
                </div>

                <div class="cw-messages" id="cwMessages">
                    @foreach (var msg in messages)
                    {
                        var mine = msg.SenderId == currentUserId;
                        <div class="cw-msg @(mine ? "cw-msg-mine" : "cw-msg-theirs")">
                            <div class="cw-bubble">@msg.Text</div>
                            <div class="cw-msg-meta">
                                @msg.CreatedAt.ToLocalTime().ToString("HH:mm")
                                @if (mine)
                                {
                                    <span>@(msg.IsRead ? " ✓✓" : " ✓")</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="cw-input-row">
                    <input class="cw-input"
                           placeholder="Сообщение..."
                           @bind="inputText"
                           @bind:event="oninput"
                           @onkeydown="OnKeyDown"
                           maxlength="1000" />
                    <button class="cw-send"
                            @onclick="SendMessage"
                            disabled="@(string.IsNullOrWhiteSpace(inputText))">
                        ➤
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    // ── DTOs ──────────────────────────────────────────────────
    class DialogDto
    {
        public int ParkingId { get; set; }
        public int OtherId { get; set; }
        public string ParkingName { get; set; } = "";
        public string OtherName { get; set; } = "";
        public string LastMessage { get; set; } = "";
        public DateTime LastAt { get; set; }
        public int Unread { get; set; }
    }

    class MessageDto
    {
        public int Id { get; set; }
        public int SenderId { get; set; }
        public int ReceiverId { get; set; }
        public int ParkingId { get; set; }
        public string Text { get; set; } = "";
        public bool IsRead { get; set; }
        public DateTime CreatedAt { get; set; }
        public string SenderName { get; set; } = "";
    }

    // ── State ─────────────────────────────────────────────────
    private bool isOpen = false;
    private bool initialized = false;
    private bool loading = false;
    private string view = "dialogs"; // dialogs | chat
    private string authToken = "";
    private int currentUserId = 0;
    private int unreadCount = 0;
    private List<DialogDto> dialogs = new();
    private List<MessageDto> messages = new();
    private DialogDto? activeDialog = null;
    private string inputText = "";
    private DotNetObjectReference<ChatWidget>? selfRef;

    // ── Lifecycle ─────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || initialized) return;
        initialized = true;

        try
        {
            authToken = await JS.InvokeAsync<string>("localStorage.getItem", "authToken") ?? "";
            var uid = await JS.InvokeAsync<string>("localStorage.getItem", "userId") ?? "0";
            int.TryParse(uid, out currentUserId);
        }
        catch { return; }

        if (string.IsNullOrEmpty(authToken) || currentUserId == 0) return;

        selfRef = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync("chatClient.setRef", selfRef);

        // // Подключаем SignalR напрямую к API (не через Blazor-хост)
        // var apiBase = Nav.BaseUri.Contains("5150")
        //     ? "http://localhost:5545"
        //     : "http://localhost:5545"; // TODO: взять из конфига
        var hubUrl = Nav.BaseUri.TrimEnd('/') + "/hubs/chat";
        await JS.InvokeVoidAsync("chatClient.start", hubUrl, authToken, selfRef);
        // await JS.InvokeVoidAsync("chatClient.start",
        //     apiBase + "/hubs/chat", authToken, selfRef);

        await LoadUnreadCount();
        StateHasChanged();
    }

    // ── Панель ────────────────────────────────────────────────
    private async Task ToggleOpen()
    {
        isOpen = !isOpen;
        if (isOpen && view == "dialogs")
            await LoadDialogs();
    }

    private async Task LoadDialogs()
    {
        loading = true;
        StateHasChanged();
        try
        {
            var client = ClientFactory.CreateClient("api");
            using var req = new HttpRequestMessage(HttpMethod.Get,
                "http://apiservice/api/messages/dialogs");
            req.Headers.Authorization = new("Bearer", authToken);
            var resp = await client.SendAsync(req);
            if (resp.IsSuccessStatusCode)
                dialogs = await resp.Content.ReadFromJsonAsync<List<DialogDto>>(
                    new System.Text.Json.JsonSerializerOptions
                    { PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch { }
        finally { loading = false; }
    }

    private async Task LoadUnreadCount()
    {
        try
        {
            var client = ClientFactory.CreateClient("api");
            using var req = new HttpRequestMessage(HttpMethod.Get,
                "http://apiservice/api/messages/unread-count");
            req.Headers.Authorization = new("Bearer", authToken);
            var resp = await client.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                unreadCount = json.GetProperty("count").GetInt32();
            }
        }
        catch { }
    }

    // ── Диалог ────────────────────────────────────────────────
    private async Task OpenDialog(DialogDto d)
    {
        activeDialog = d;
        messages = new();
        view = "chat";
        StateHasChanged();

        try
        {
            var client = ClientFactory.CreateClient("api");
            using var req = new HttpRequestMessage(HttpMethod.Get,
                $"http://apiservice/api/messages/{d.ParkingId}/{d.OtherId}");
            req.Headers.Authorization = new("Bearer", authToken);
            var resp = await client.SendAsync(req);
            if (resp.IsSuccessStatusCode)
                messages = await resp.Content.ReadFromJsonAsync<List<MessageDto>>(
                    new System.Text.Json.JsonSerializerOptions
                    { PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch { }

        await JS.InvokeVoidAsync("chatClient.markRead", d.OtherId, d.ParkingId);
        d.Unread = 0;
        unreadCount = Math.Max(0, unreadCount - d.Unread);
        await LoadUnreadCount();

        StateHasChanged();
        await JS.InvokeVoidAsync("chatClient.scrollToBottom", "cwMessages");
    }

    // Метод для вызова снаружи (со страницы парковки)
    [JSInvokable]
    public async Task StartDialogWith(int ownerId, string ownerName,
                                      int parkingId, string parkingName)
    {
        var existing = dialogs.FirstOrDefault(
            d => d.ParkingId == parkingId && d.OtherId == ownerId);

        if (existing == null)
        {
            existing = new DialogDto
            {
                ParkingId = parkingId,
                OtherId = ownerId,
                ParkingName = parkingName,
                OtherName = ownerName,
                LastMessage = "",
                LastAt = DateTime.UtcNow
            };
            dialogs.Insert(0, existing);
        }

        isOpen = true;
        await OpenDialog(existing);
    }

    private void BackToDialogs()
    {
        activeDialog = null;
        messages = new();
        view = "dialogs";
    }

    // ── Отправка ──────────────────────────────────────────────
    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(inputText) || activeDialog == null) return;
        var text = inputText.Trim();
        inputText = "";
        await JS.InvokeVoidAsync("chatClient.sendMessage",
            activeDialog.OtherId, activeDialog.ParkingId, text);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }

    // ── SignalR callbacks ─────────────────────────────────────
    [JSInvokable]
    public async Task OnReceiveMessage(System.Text.Json.JsonElement raw)
    {
        var msg = System.Text.Json.JsonSerializer.Deserialize<MessageDto>(
            raw.GetRawText(),
            new System.Text.Json.JsonSerializerOptions
            { PropertyNameCaseInsensitive = true });
        if (msg == null) return;

        if (activeDialog != null
            && msg.ParkingId == activeDialog.ParkingId
            && msg.SenderId == activeDialog.OtherId)
        {
            messages.Add(msg);
            await JS.InvokeVoidAsync("chatClient.markRead",
                activeDialog.OtherId, activeDialog.ParkingId);
            StateHasChanged();
            await JS.InvokeVoidAsync("chatClient.scrollToBottom", "cwMessages");
        }
        else
        {
            unreadCount++;
            await LoadDialogs();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnMessageSent(System.Text.Json.JsonElement raw)
    {
        var msg = System.Text.Json.JsonSerializer.Deserialize<MessageDto>(
            raw.GetRawText(),
            new System.Text.Json.JsonSerializerOptions
            { PropertyNameCaseInsensitive = true });
        if (msg == null) return;
        messages.Add(msg);

        // Обновляем последнее сообщение в диалоге
        var d = dialogs.FirstOrDefault(
            x => x.ParkingId == msg.ParkingId && x.OtherId == msg.ReceiverId);
        if (d != null) { d.LastMessage = msg.Text; d.LastAt = msg.CreatedAt; }

        StateHasChanged();
        await JS.InvokeVoidAsync("chatClient.scrollToBottom", "cwMessages");
    }

    [JSInvokable]
    public Task OnMessagesRead(int parkingId, int readBy)
    {
        foreach (var m in messages
            .Where(m => m.ParkingId == parkingId && m.ReceiverId == readBy))
            m.IsRead = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("chatClient.stop"); } catch { }
        selfRef?.Dispose();
    }
}
