@page "/parking/{Id:int}"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject IHttpClientFactory ClientFactory
@using System.Text.Json
@implements IAsyncDisposable

<HeadContent>
    <link rel="stylesheet" href="css/parking.css" />
</HeadContent>

<div class="pk-content">
    @if (isPageLoading)
    {
        <div class="pk-card" style="padding:2rem">⏳ Загрузка...</div>
    }
    else if (parking == null)
    {
        <div class="pk-card" style="padding:2rem;color:#BB0000">⚠ Парковка не найдена</div>
    }
    else
    {
        <div class="pk-camera-card pk-card">
            <div class="pk-card-header">
                <h2 class="pk-card-title">📷 @parking.Name</h2>
                <span class="pk-card-subtitle">@parking.Address</span>
            </div>

            <div class="pk-canvas-wrap @(isDrawing ? "pk-image-frozen" : "")">
                <img id="parkingImage" src="@snapshotUrl" width="640" height="480" />
                <canvas id="parkingCanvas" width="640" height="480"></canvas>
            </div>

            @if (isDrawing)
            {
                <div class="pk-message-strip">
                    <span class="pk-message-strip-icon"></span>
                    <span>
                        Режим разметки.&nbsp;
                        <kbd>ЛКМ</kbd> — точка &nbsp;·&nbsp;
                        <kbd>ПКМ</kbd> — удалить &nbsp;·&nbsp;
                        <strong>4 точки</strong> = место
                    </span>
                </div>
            }
        </div>

        <div class="pk-sidebar">

            <!-- Статистика — видна всем -->
            <div class="pk-card">
                <div class="pk-card-header">
                    <h2 class="pk-card-title">Загруженность</h2>
                    @if (parking.LastCheckedAt.HasValue)
                    {
                        <span class="pk-card-subtitle">
                            @parking.LastCheckedAt.Value.ToLocalTime().ToString("HH:mm:ss")
                        </span>
                    }
                </div>
                <div class="pk-card-body">
                    <div class="pk-kv">
                        <span class="pk-kv-label">Свободно</span>
                        <span class="pk-kv-val-big" style="color:#107E3E">@parking.FreeSpots</span>
                    </div>
                    <div class="pk-kv">
                        <span class="pk-kv-label">Занято</span>
                        <span class="pk-kv-val-big" style="color:#BB0000">@parking.BusySpots</span>
                    </div>
                    <div class="pk-kv">
                        <span class="pk-kv-label">Всего мест</span>
                        <span class="pk-kv-val">@spaceCount</span>
                    </div>
                    @if (!string.IsNullOrEmpty(authToken))
                    {
                        <div class="pk-card-footer" style="padding:0.5rem 1rem; border-top:1px solid #e5e5e5;">
                            <button class="pk-btn @(isFavorite ? "pk-btn-attention" : "pk-btn-default")"
                                    @onclick="ToggleFavorite">
                                @(isFavorite ? "★ В избранном" : "☆ Добавить в избранное")
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Режим отображения — для всех -->
            <div class="pk-card">
                <div class="pk-card-header">
                    <h2 class="pk-card-title">Отображение</h2>
                </div>
                <div class="pk-card-body">

                    <button class="pk-btn @(viewMode == "live" ? "pk-btn-emphasized" : "pk-btn-default")"
                            @onclick='() => SetViewMode("live")'>
                        📷 Только видео
                    </button>

                    <button class="pk-btn @(viewMode == "occupancy" ? "pk-btn-emphasized" : "pk-btn-default")"
                            @onclick='() => SetViewMode("occupancy")'>
                        🟢 Показать загруженность
                    </button>

                    @if (viewMode == "occupancy")
                    {
                        <div class="pk-info-strip" style="margin-top:0.5rem">
                            <span></span>
                            <div>
                                <span style="color:#22aa22">■</span> Свободно &nbsp;
                                <span style="color:#cc2222">■</span> Занято
                            </div>
                        </div>
                    }

                    @if (isOwner)
                    {
                        <hr style="border:none; border-top:1px solid #e0e0e0; margin:0.75rem 0;" />

                        @if (viewMode != "draw")
                        {
                            <button class="pk-btn pk-btn-attention"
                                    @onclick='() => SetViewMode("draw")'>
                                ✏ Изменить разметку
                            </button>
                        }
                        else
                        {
                            <button class="pk-btn pk-btn-attention"
                                    @onclick='() => SetViewMode("live")'>
                                ⏹ Завершить редактирование
                            </button>
                            <button class="pk-btn pk-btn-positive"
                                    @onclick="SaveSpaces"
                                    disabled="@(spaceCount == 0 || isSaving)">
                                @(isSaving ? "⏳ Сохранение..." : "💾 Сохранить разметку")
                            </button>
                            <button class="pk-btn pk-btn-default"
                                    @onclick="UndoLast">
                                ↩ Отменить последнее
                            </button>
                            <button class="pk-btn pk-btn-negative"
                                    @onclick="ClearAll"
                                    disabled="@(spaceCount == 0)">
                                🗑 Очистить всё
                            </button>
                            <div class="pk-info-strip" style="margin-top:0.5rem">
                                <span>ℹ️</span>
                                <div>
                                    <kbd>ЛКМ</kbd> — точка<br />
                                    <kbd>ПКМ</kbd> — удалить<br />
                                    <strong>4 точки</strong> = место
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @if (!isOwner && !string.IsNullOrEmpty(authToken))
            {
                <div class="pk-card">
                    <div class="pk-card-body">
                        <button class="pk-btn pk-btn-default" @onclick="ContactOwner">
                            💬 Написать владельцу
                        </button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(saveMessage))
            {
                <div class="pk-card">
                    <div class="pk-card-header">
                        <h2 class="pk-card-title">@saveMessage</h2>
                    </div>
                </div>
            }

        </div>
    }
</div>

@* Внизу страницы, после основного контента *@
 @if (parking != null)
{
    <div style="grid-column: 1 / -1; margin-top: 1rem;">
        <ParkingStats ParkingId="@Id" />
    </div>
} 

@code {

    [Parameter] public int Id { get; set; }
    private bool isFavorite = false;
    
    private System.Threading.Timer? _refreshTimer;

    class ParkingDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Address { get; set; } = "";
        public string? StreamUrl { get; set; }
        public string StreamType { get; set; } = "JPG";
        public int RefreshInterval { get; set; } = 5;
        public int FreeSpots { get; set; }
        public int BusySpots { get; set; }
        public int UserId { get; set; }
        public DateTime? LastCheckedAt { get; set; }
    }

    class JsSpace
    {
        public int Id { get; set; }
        public List<JsPoint> Points { get; set; } = new();
    }
    class JsPoint { public double X { get; set; } public double Y { get; set; } }
    class SaveSpacesRequest { public List<JsSpace> Spaces { get; set; } = new(); }

    private ParkingDto? parking;
    private bool isPageLoading = true;
    // private bool isDrawing = false;
    private bool isSaving = false;
    private bool isOwner = false;
    // private bool occupancyModeOn = false;
    private string spacesJsonCache = "[]";
    // private bool hasSpacesLoadedForEditing = false;
    private int spaceCount = 0;
    private string snapshotUrl = "";
    private string saveMessage = "";
    private string authToken = "";
    private int currentUserId = 0;
    private DotNetObjectReference<Parking>? selfRef;
    private string viewMode = "live"; // "live" | "occupancy" | "draw"
    private bool isDrawing => viewMode == "draw";
    private bool hasSpacesLoadedForEditing = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            authToken = await JS.InvokeAsync<string>("localStorage.getItem", "authToken") ?? "";
            var userIdStr = await JS.InvokeAsync<string>("localStorage.getItem", "userId") ?? "0";
            int.TryParse(userIdStr, out currentUserId);
        }
        catch { }

        // Загружаем парковку
        try
        {
            var client = ClientFactory.CreateClient("api");
            using var req = new HttpRequestMessage(HttpMethod.Get,
                "http://apiservice/api/parkings/" + Id);
            if (!string.IsNullOrEmpty(authToken))
                req.Headers.Authorization = new("Bearer", authToken);
            var resp = await client.SendAsync(req);
            if (resp.IsSuccessStatusCode)
                parking = await resp.Content.ReadFromJsonAsync<ParkingDto>();
            if (!string.IsNullOrEmpty(authToken))
                await LoadFavoriteStatus();
        }
        catch { }
        finally { isPageLoading = false; }

        if (parking == null) { StateHasChanged(); return; }

        isOwner = parking.UserId == currentUserId;

        if (parking.StreamUrl != null)
        {
            var encodedUrl = Uri.EscapeDataString(parking.StreamUrl);
            snapshotUrl = parking.StreamType == "MJPEG"
                ? "/api/camera/snapshot?type=MJPEG&url=" + encodedUrl
                : "/api/camera/snapshot?url=" + encodedUrl;
        }

        StateHasChanged();

        // Инициализируем canvas
        selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("parkingCanvas.init", "parkingCanvas", selfRef);
        await JS.InvokeVoidAsync("parkingCanvas.startLive", "parkingImage",
                                 parking.RefreshInterval * 1000);

        // Загружаем разметку и статус занятости
        await LoadSpaces();

        _refreshTimer = new System.Threading.Timer(
    async _ => await RefreshOccupancy(),
    null,
    TimeSpan.FromSeconds(parking.RefreshInterval),
    TimeSpan.FromSeconds(parking.RefreshInterval));
    }

    private async Task RefreshOccupancy()
    {
        if (parking == null) return;
        try
        {
            var client = ClientFactory.CreateClient("api");

            // Обновляем данные парковки (FreeSpots, BusySpots, LastCheckedAt)
            using var req = new HttpRequestMessage(HttpMethod.Get,
                "http://apiservice/api/parkings/" + Id);
            var resp = await client.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                var updated = await resp.Content.ReadFromJsonAsync<ParkingDto>();
                if (updated != null)
                {
                    parking.FreeSpots = updated.FreeSpots;
                    parking.BusySpots = updated.BusySpots;
                    parking.LastCheckedAt = updated.LastCheckedAt;
                }
            }

            // Обновляем полигоны с новым статусом занятости
            var spacesResp = await client.GetAsync(
                "http://apiservice/api/parkings/" + Id + "/spaces");
            if (spacesResp.IsSuccessStatusCode)
            {
                var json = await spacesResp.Content.ReadAsStringAsync();
                spacesJsonCache = json;

                var loaded = System.Text.Json.JsonSerializer
                    .Deserialize<List<JsSpace>>(json,
                        new System.Text.Json.JsonSerializerOptions
                        { PropertyNameCaseInsensitive = true }) ?? new();
                spaceCount = loaded.Count;

                // Если сейчас режим загруженности — перерисовываем полигоны
                if (viewMode == "occupancy")
                    await InvokeAsync(async () =>
                    {
                        await JS.InvokeVoidAsync("parkingCanvas.setOccupancy", json);
                        await JS.InvokeVoidAsync("parkingCanvas.enableOccupancyMode");
                    });
            }

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task LoadFavoriteStatus()
    {
        try
        {
            var client = ClientFactory.CreateClient("api");
            using var req = new HttpRequestMessage(HttpMethod.Get,
                "http://apiservice/api/favorites/ids");
            req.Headers.Authorization = new("Bearer", authToken);
            var resp = await client.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                var ids = await resp.Content.ReadFromJsonAsync<List<int>>() ?? new();
                isFavorite = ids.Contains(Id);
            }
        }
        catch { }
    }

    private async Task ToggleFavorite()
    {
        try
        {
            var client = ClientFactory.CreateClient("api");
            var method = isFavorite ? HttpMethod.Delete : HttpMethod.Post;
            using var req = new HttpRequestMessage(method,
                "http://apiservice/api/favorites/" + Id);
            req.Headers.Authorization = new("Bearer", authToken);
            var resp = await client.SendAsync(req);
            if (resp.IsSuccessStatusCode)
                isFavorite = !isFavorite;
        }
        catch { }
    }

    private async Task LoadSpaces()
    {
        try
        {
            var client = ClientFactory.CreateClient("api");
            var resp = await client.GetAsync(
                "http://apiservice/api/parkings/" + Id + "/spaces");

            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                spacesJsonCache = json;

                var loaded = JsonSerializer.Deserialize<List<JsSpace>>(json,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                spaceCount = loaded.Count;

                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task SetViewMode(string mode)
    {
        var prev = viewMode;
        viewMode = mode;

        switch (mode)
        {
            case "live":
                if (prev == "draw")
                    await JS.InvokeVoidAsync("parkingCanvas.disableDraw");
                await JS.InvokeVoidAsync("parkingCanvas.disableOccupancyMode");
                break;

            case "occupancy":
                if (prev == "draw")
                    await JS.InvokeVoidAsync("parkingCanvas.disableDraw");
                if (!string.IsNullOrWhiteSpace(spacesJsonCache))
                    await JS.InvokeVoidAsync("parkingCanvas.setOccupancy", spacesJsonCache);
                await JS.InvokeVoidAsync("parkingCanvas.enableOccupancyMode");
                break;

            case "draw":
                await JS.InvokeVoidAsync("parkingCanvas.disableOccupancyMode");
                if (!hasSpacesLoadedForEditing && !string.IsNullOrWhiteSpace(spacesJsonCache))
                {
                    await JS.InvokeVoidAsync("parkingCanvas.loadSpaces", spacesJsonCache);
                    hasSpacesLoadedForEditing = true;
                }
                await JS.InvokeVoidAsync("parkingCanvas.enableDraw", "parkingImage");
                break;
        }
    }

    private async Task UndoLast()
    {
        await JS.InvokeVoidAsync("parkingCanvas.undoLast");
        spaceCount = await JS.InvokeAsync<int>("parkingCanvas.getSpaceCount");
    }

    private async Task ClearAll()
    {
        await JS.InvokeVoidAsync("parkingCanvas.clearAll");
        spaceCount = 0; saveMessage = "";
    }

    private async Task SaveSpaces()
    {
        isSaving = true; saveMessage = "";
        try
        {
            var raw = await JS.InvokeAsync<string>("parkingCanvas.getSpaces");
            var jsSpaces = JsonSerializer.Deserialize<List<JsSpace>>(raw,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();

            var client = ClientFactory.CreateClient("api");
            using var req = new HttpRequestMessage(HttpMethod.Post,
                "http://apiservice/api/parkings/" + Id + "/spaces");
            req.Headers.Authorization = new("Bearer", authToken);
            req.Content = JsonContent.Create(new SaveSpacesRequest { Spaces = jsSpaces });

            var resp = await client.SendAsync(req);
            saveMessage = resp.IsSuccessStatusCode
                ? "✅ Сохранено — " + spaceCount + " мест"
                : "⚠ Ошибка сохранения";
        }
        catch { saveMessage = "⚠ Ошибка подключения"; }
        finally { isSaving = false; }
    }

    [JSInvokable]
    public void OnSpaceAdded(int count)
    {
        spaceCount = count;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _refreshTimer?.Dispose();  // ← добавить
        try { await JS.InvokeVoidAsync("parkingCanvas.dispose"); } catch { }
        selfRef?.Dispose();
    }

    private async Task ContactOwner()
    {
        try
        {
            var client = ClientFactory.CreateClient("api");
            using var req = new HttpRequestMessage(HttpMethod.Get,
                "http://apiservice/api/messages/owner/" + Id);
            req.Headers.Authorization = new("Bearer", authToken);
            var resp = await client.SendAsync(req);
            if (!resp.IsSuccessStatusCode) return;

            var json = await resp.Content.ReadFromJsonAsync<JsonElement>();
            var ownerId = json.GetProperty("ownerId").GetInt32();
            var ownerName = json.GetProperty("ownerName").GetString() ?? "";
            var parkingName = json.GetProperty("parkingName").GetString() ?? "";

            // Открываем чат-виджет через JS
            await JS.InvokeVoidAsync("window.openChatWith",
                ownerId, ownerName, Id, parkingName);
        }
        catch { }
    }

}
