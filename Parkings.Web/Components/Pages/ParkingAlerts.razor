@rendermode InteractiveServer
@inject IHttpClientFactory ClientFactory

<div class="pk-card">
    <div class="pk-card-header">
        <h2 class="pk-card-title">🔔 Алармы</h2>
        <div style="display:flex;gap:0.75rem;align-items:center">

            <label class="pk-toggle-label" title="Включить/выключить email-рассылку алармов">
                <span style="font-size:0.75rem;color:#556B82">
                    📧 Рассылка
                </span>
                <div class="pk-toggle @(alertsEnabled ? "pk-toggle-on" : "")"
                     @onclick="ToggleAlerts">
                    <div class="pk-toggle-knob"></div>
                </div>
            </label>

            @if (alerts.Count > 0)
            {
                <button class="pk-btn pk-btn-negative"
                        style="font-size:0.72rem;padding:2px 10px"
                        @onclick="ClearAlerts">
                    🗑 Очистить
                </button>
            }
        </div>
    </div>

    <div class="pk-card-body" style="padding:0">
        @if (isLoading)
        {
            <div class="pk-stats-empty">⏳ Загрузка...</div>
        }
        else if (alerts.Count == 0)
        {
            <div class="pk-stats-empty">Алармов нет 🎉</div>
        }
        else
        {
            <div class="pk-alerts-table-wrap">
                <table class="pk-stats-table">
                    <thead>
                        <tr>
                            <th style="width:140px">Время</th>
                            <th style="width:120px">Тип</th>
                            <th>Сообщение</th>
                            <th style="width:80px;text-align:center">Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in alerts)
                        {
                            <tr>
                                <td style="font-size:0.78rem;color:#556B82">
                                    @a.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    @if (a.Type == "url_down")
                                    {
                                        <span class="pk-alert-badge pk-alert-down">
                                            ⚠ Недоступен
                                        </span>
                                    }
                                    else if (a.Type == "url_restored")
                                    {
                                        <span class="pk-alert-badge pk-alert-up">
                                            ✅ Восстановлен
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pk-alert-badge pk-alert-info">
                                            ℹ @a.Type
                                        </span>
                                    }
                                </td>
                                <td style="font-size:0.78rem">@a.Message</td>
                                <td style="text-align:center;font-size:0.875rem">
                                    @(a.EmailSent ? "✉" : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div style="display:flex;justify-content:center;gap:0.375rem;
                                    padding:0.625rem;border-top:1px solid #f0f0f0">
                    <button class="mp-btn mp-btn-default"
                            style="padding:2px 10px;font-size:0.78rem"
                            disabled="@(currentPage <= 1)"
                            @onclick="() => GoToPage(currentPage - 1)">
                        ←
                    </button>
                    <span style="font-size:0.78rem;color:#556B82;padding:4px 8px">
                        @currentPage / @totalPages
                    </span>
                    <button class="mp-btn mp-btn-default"
                            style="padding:2px 10px;font-size:0.78rem"
                            disabled="@(currentPage >= totalPages)"
                            @onclick="() => GoToPage(currentPage + 1)">
                        →
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public int ParkingId { get; set; }
    [Parameter] public string AuthToken { get; set; } = "";
    [Parameter] public bool InitialAlertsEnabled { get; set; } = true;

    class AlertDto
    {
        public int Id { get; set; }
        public string Type { get; set; } = "";
        public string Message { get; set; } = "";
        public bool EmailSent { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    private List<AlertDto> alerts = new();
    private bool isLoading = false;
    private bool alertsEnabled = true;
    private int currentPage = 1;
    private int totalPages = 1;
    private int total = 0;
    private const int PageSize = 15;

    protected override async Task OnParametersSetAsync()
    {
        alertsEnabled = InitialAlertsEnabled;
        await LoadAlerts();
    }

    private async Task LoadAlerts()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var client = ClientFactory.CreateClient("api");
            using var req = new HttpRequestMessage(HttpMethod.Get,
                $"http://apiservice/api/parkings/{ParkingId}/alerts" +
                $"?page={currentPage}&pageSize={PageSize}");
            req.Headers.Authorization = new("Bearer", AuthToken);
            var resp = await client.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content
                    .ReadFromJsonAsync<System.Text.Json.JsonElement>();
                alerts = System.Text.Json.JsonSerializer.Deserialize<List<AlertDto>>(
                    json.GetProperty("alerts").GetRawText(),
                    new System.Text.Json.JsonSerializerOptions
                    { PropertyNameCaseInsensitive = true }) ?? new();
                total = json.GetProperty("total").GetInt32();
                totalPages = (int)Math.Ceiling(total / (double)PageSize);
            }
        }
        catch { }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task ToggleAlerts()
    {
        try
        {
            var client = ClientFactory.CreateClient("api");
            using var req = new HttpRequestMessage(HttpMethod.Put,
                $"http://apiservice/api/parkings/{ParkingId}/alerts/toggle");
            req.Headers.Authorization = new("Bearer", AuthToken);
            var resp = await client.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content
                    .ReadFromJsonAsync<System.Text.Json.JsonElement>();
                alertsEnabled = json.GetProperty("alertsEnabled").GetBoolean();
            }
        }
        catch { }
    }

    private async Task ClearAlerts()
    {
        try
        {
            var client = ClientFactory.CreateClient("api");
            using var req = new HttpRequestMessage(HttpMethod.Delete,
                $"http://apiservice/api/parkings/{ParkingId}/alerts");
            req.Headers.Authorization = new("Bearer", AuthToken);
            await client.SendAsync(req);
            alerts = new();
            total = 0;
            totalPages = 1;
            currentPage = 1;
            StateHasChanged();
        }
        catch { }
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadAlerts();
    }
}
